APP_NAME="GML-SHIELD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# Cle dediee au chiffrement AES-256-GCM des codes secrets.
# Generer avec : openssl rand -base64 32
# Ne pas reutiliser APP_KEY et ne jamais versionner la vraie cle.
SECRET_CODE_KEY=

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gml_shield
DB_USERNAME=gml_shield
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Connexion Laravel vers le service Docker Reverb
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Adresse d'écoute du serveur Reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Domaines autorises pour les connexions WebSocket (sans http:// ni https://)
REVERB_ALLOWED_ORIGINS=localhost

# Les navigateurs ne peuvent pas emettre d'evenements WebSocket
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none

# Connexion du navigateur vers Reverb
# Ces variables servent de reference pour la configuration du navigateur.
# Le frontend Docker utilise son propre fichier frontend/.env.local.
# VITE_REVERB_APP_KEY doit correspondre a REVERB_APP_KEY.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
