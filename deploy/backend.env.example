# GML-SHIELD — Configuration de production K8
# Exemple uniquement : ne contient aucun secret réel.

APP_NAME=GML-SHIELD
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gml-shield.mkcodecreations.dev

HASH_DRIVER=argon2id

TRUSTED_PROXIES=

FRONTEND_URL=https://gml-shield.mkcodecreations.dev
SANCTUM_STATEFUL_DOMAINS=gml-shield.mkcodecreations.dev

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gml_shield
DB_USERNAME=gml_shield
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

SECRET_CODE_KEY=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://gml-shield.mkcodecreations.dev
REVERB_APP_ACCEPT_CLIENT_EVENTS_FROM=none