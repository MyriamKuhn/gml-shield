# GML-SHIELD — Configuration du frontend en développement local
# Copier ce fichier vers frontend/.env.local

# API Laravel accessible depuis le navigateur
VITE_API_URL=http://localhost:8000

# Clé publique de l'application Laravel Reverb
# Doit correspondre à REVERB_APP_KEY dans backend/.env
VITE_REVERB_APP_KEY=

# Connexion WebSocket depuis le navigateur
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Ne jamais placer APP_KEY, SECRET_CODE_KEY,
# REVERB_APP_SECRET ou DB_PASSWORD dans un fichier Vite.